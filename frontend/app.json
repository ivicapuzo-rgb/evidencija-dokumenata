{
  "expo": {
    "name": "Евиденција докумената",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.expirynotifier.s1j98n",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Учитајте доказ о уплати претплате"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#EA580C"
      },
      "package": "com.emergent.expirynotifier.s1j98n",
      "permissions": ["READ_MEDIA_IMAGES", "POST_NOTIFICATIONS"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FF9902"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Учитајте доказ о уплати претплате"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
